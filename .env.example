# Mall över vilka variabler appen använder.
#
# Du behöver inte kopiera den här filen för hand – "npm run setup" skapar en
# .env med slumpade hemligheter åt dig. Databasadresserna måste du dock fylla
# i själv, eftersom de är knutna till ditt Supabase-projekt.

# Appens anslutning. I Supabase: Project Settings > Database >
# Connection string > Transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.PROJEKT:LOSENORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Migreringarnas anslutning. Poolaren klarar inte schemaändringar, så den här
# ska peka på Direct connection (port 5432). Kör du en egen Postgres kan båda
# vara samma adress.
DIRECT_URL="postgresql://postgres:LOSENORD@db.PROJEKT.supabase.co:5432/postgres"

# Signerar sessionscookien. Måste vara minst 16 tecken; använd ett långt
# slumpat värde. Alla sessioner upphör när den ändras.
AUTH_SECRET="byt-till-en-lang-slumpmassig-hemlighet"

# Skyddar /api/cron/paminnelser, som skapar varningar innan certifikat
# löper ut. Skickas som huvudet x-cron-key.
CRON_KEY="byt-till-en-slumpmassig-nyckel"

# --- Endast i drift (Vercel) ---
# Bilagor sparas i Supabase Storage när de här är satta, annars på disk.
# Nyckeln går förbi radsäkerheten och får bara användas på servern.
# Hämtas i Supabase under Settings > API.
SUPABASE_URL="https://PROJEKT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service_role-nyckeln"
